{"locale_data":{"messages":{"":{"plural_forms":"nplurals=1; plural=0;","language":"zh_CN","project_id_version":"WooCommerce - WooCommerce Payments"},"Some account related notifications require HTTPS and cannot be displayed. View them on our financial partner\u2019s website. {{seeDetailsLink}}See details{{\/seeDetailsLink}}":["\u67d0\u4e9b\u4e0e\u8d26\u6237\u76f8\u5173\u7684\u901a\u77e5\u9700\u8981 HTTPS \u624d\u80fd\u663e\u793a\u3002 \u8bf7\u5728\u6211\u4eec\u91d1\u878d\u5408\u4f5c\u4f19\u4f34\u7684\u7f51\u7ad9\u4e0a\u67e5\u770b\u8fd9\u4e9b\u5185\u5bb9\u3002 {{seeDetailsLink}}\u67e5\u770b\u8be6\u7ec6\u4fe1\u606f{{\/seeDetailsLink}}"],"Refresh":["\u5237\u65b0"],"Updates take a moment to appear. Please refresh the page in a minute.":["\u66f4\u65b0\u5185\u5bb9\u9700\u8981\u4e00\u6bb5\u65f6\u95f4\u624d\u80fd\u663e\u73b0\u3002 \u8bf7\u7a0d\u540e\u5237\u65b0\u6b64\u9875\u9762\u3002"],"Success! You can start using WooPayments in test mode.":["\u6210\u529f\uff01 \u60a8\u53ef\u4ee5\u5728\u6d4b\u8bd5\u6a21\u5f0f\u4e0b\u5f00\u59cb\u4f7f\u7528 WooPayments\u3002"],"There was a problem resetting your account. Please wait a few seconds and try again.":["\u91cd\u7f6e\u60a8\u7684\u8d26\u6237\u65f6\u51fa\u73b0\u95ee\u9898\u3002 \u8bf7\u7b49\u5f85\u51e0\u79d2\uff0c\u7136\u540e\u91cd\u8bd5\u3002"],"There was a problem redirecting you to the requested link. Please check that it is valid and try again.":["\u5c06\u60a8\u91cd\u5b9a\u5411\u5230\u8bf7\u6c42\u7684\u94fe\u63a5\u65f6\u51fa\u73b0\u95ee\u9898\u3002 \u8bf7\u68c0\u67e5\u8be5\u94fe\u63a5\u662f\u5426\u6709\u6548\uff0c\u7136\u540e\u91cd\u8bd5\u3002"],"There was a problem redirecting you to the loan offer. Please check that it is not expired and try again.":["\u5728\u5c06\u60a8\u91cd\u5b9a\u5411\u81f3\u8d37\u6b3e\u4f18\u60e0\u65f6\u51fa\u73b0\u4e86\u95ee\u9898\u3002 \u8bf7\u68c0\u67e5\u91cd\u5b9a\u5411\u662f\u5426\u5df2\u8fc7\u671f\uff0c\u7136\u540e\u91cd\u8bd5\u3002"],"There was a problem redirecting you to the account dashboard. Please try again.":["\u5c06\u60a8\u91cd\u5b9a\u5411\u5230\u8d26\u6237\u63a7\u5236\u9762\u677f\u65f6\u51fa\u73b0\u95ee\u9898\u3002 \u8bf7\u91cd\u8bd5\u3002"]}}}