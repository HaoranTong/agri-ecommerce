{
    "name": "shanghetun/agri-ecommerce",
    "description": "常香米坊农业电商平台",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "johnpbloch/wordpress": "^6.7.0",
        "composer/installers": "^v2.0",
        
        "wpackagist-plugin/woocommerce": "^10.3.5",
        "wpackagist-plugin/elementor": "^3.33.2",
        "wpackagist-plugin/cartflows": "^2.1.17",
        "wpackagist-plugin/woo-cart-abandonment-recovery": "^2.0.4",
        "wpackagist-plugin/loco-translate": "^2.8.0",
        "wpackagist-plugin/astra-sites": "^4.4.43",
        "wpackagist-plugin/header-footer-elementor": "^2.7.0",
        "wpackagist-plugin/variation-swatches-woo": "^1.0.13",
        "wpackagist-plugin/wp-reset": "^2.06"
    },
    "repositories": [
        {
            "type": "path",
            "url": "./wp-content/plugins/myshop-core"
        },
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    ],
    "extra": {
        "wordpress-install-dir": "wp",
        "installer-paths": {
            "wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
            "wp-content/the$name}/": ["type:wordpress-theme"]
        }
    },
    "config": {
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true,
            "composer/installers": true
        }
    }
}