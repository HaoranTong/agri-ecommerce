# ================================
# AgriEcommerce - 精准忽略规则（最终版）
# 目标：跟踪所有代码，忽略所有配置和数据
# ================================

# [核心] 忽略环境配置文件（每个服务器独有，必须忽略！）
wp-config.php
.htaccess
.env
*.env.local

# [核心] 忽略Composer依赖目录（由composer.json和composer.lock管理，勿跟踪！）
/vendor/
composer.lock

# [核心] 忽略用户上传的内容（媒体库、文件等）
/wp-content/uploads/

# [核心] 忽略各种缓存目录（非源代码，自动生成）
/wp-content/cache/
/wp-content/upgrade/

# [核心] 忽略所有日志文件（开发、生产环境各自生成）
*.log
wp-content/debug.log
error_log

# 忽略IDE和编辑器配置文件（个人工具设置）
.vscode/
.idea/
*.swp
*.swo

# 忽略操作系统生成的文件
.DS_Store
Thumbs.db

# 忽略其他可能的构建工具目录（如未来有）
node_modules/
npm-debug.log*